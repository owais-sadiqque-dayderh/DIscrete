# ============================================================================
# DIscrete configuration. Git ignores this file (your keys never get committed).
# Blank value = "not set" = use the fallback described next to it.
# After any change:  .venv/bin/discrete doctor --models   (tests every model, < $0.01)
# ============================================================================

USER_NAME=you
# Where the database and screenshots live (Finder: Cmd+Shift+G, paste the path).
DISCRETE_DATA_DIR=~/.cache/discrete


# ----------------------------------------------------------------------------
# 1. MODELS
# Any OpenAI-compatible API works (OpenRouter by default). Each component uses
# its own _MODEL_NAME / _API_BASE / _API_KEY when set, otherwise CORE_LM_*.
# Browse models: https://openrouter.ai/models  (use the id, e.g. openai/gpt-4o-mini)
# ----------------------------------------------------------------------------

# Default for every chat component below.
CORE_LM_API_BASE=https://openrouter.ai/api/v1
CORE_LM_API_KEY=
CORE_LM_MODEL_NAME=openai/gpt-4o-mini

# Screenshot captions: one call per capture, the biggest cost. Must accept images.
CAPTION_LM_MODEL_NAME=
CAPTION_LM_API_BASE=
CAPTION_LM_API_KEY=

# Episode drafting, claim relations, entity checks (background).
INSIGHT_LM_MODEL_NAME=
INSIGHT_LM_API_BASE=
INSIGHT_LM_API_KEY=

# Independent support verifier: checks each drafted memory against its evidence
# (background) and each search result against the question (on every Bubble
# query, so pick a fast model). Blank: INSIGHT_LM, then CORE_LM.
VERIFY_LM_MODEL_NAME=
VERIFY_LM_API_BASE=
VERIFY_LM_API_KEY=

# Hourly consolidation (entity pages, digests). Blank: falls back to INSIGHT_LM, then CORE_LM.
CONSOLIDATE_LM_MODEL_NAME=

# Search query planning (Bubble waits at most DISCRETE_PLAN_TIMEOUT_S for it).
UTILITY_LM_MODEL_NAME=
UTILITY_LM_API_BASE=
UTILITY_LM_API_KEY=

# Bubble's streamed answer. Blank: falls back to INSIGHT_LM, then CORE_LM.
BUBBLE_LM_MODEL_NAME=

# Bubble reading a text field from a screenshot. Blank: falls back to CAPTION_LM. Must accept images.
BUBBLE_VISION_LM_MODEL_NAME=

# Embeddings: never falls back to a chat model. Changing it re-embeds everything.
EMBED_LM_API_BASE=https://openrouter.ai/api/v1
EMBED_LM_API_KEY=
EMBED_LM_MODEL_NAME=openai/text-embedding-3-small

# Search reranking (base and key fall back to CORE_LM). ~$0.002 per Bubble search.
RERANK_LM_MODEL_NAME=cohere/rerank-4-fast


# ----------------------------------------------------------------------------
# 2. MODEL REQUEST SETTINGS: make any model work without code changes
# Put them on CORE_LM_ to apply to every chat component, or on one component's
# prefix (CAPTION_LM_, INSIGHT_LM_, VERIFY_LM_, CONSOLIDATE_LM_, UTILITY_LM_, BUBBLE_LM_,
# BUBBLE_VISION_LM_) to override just that one. Blank = the code's own value.
#
#   _EXTRA_TOKENS      added to every reply limit. Reasoning models (Muse Spark,
#                      o-series, DeepSeek-R1, …) spend tokens thinking before they
#                      answer; without room they return nothing. Try 1000-3000.
#   _REASONING_EFFORT  minimal | low | medium | high. Less thinking = faster and
#                      cheaper. Ignored by non-reasoning models.
#   _TEMPERATURE       a number (0 = most consistent), or "off" for models that
#                      reject a temperature (some reasoning models do).
#   _JSON_MODE         false for models that reject response_format.
#   _TIMEOUT_S         seconds before a request is abandoned (default 60).
#   _EXTRA_BODY        JSON merged into every request, for anything provider-specific,
#                      e.g. {"provider": {"order": ["Groq"]}} or {"reasoning": {"max_tokens": 800}}
# ----------------------------------------------------------------------------
CORE_LM_EXTRA_TOKENS=
CORE_LM_REASONING_EFFORT=
CORE_LM_TEMPERATURE=
CORE_LM_JSON_MODE=
CORE_LM_TIMEOUT_S=
CORE_LM_EXTRA_BODY=
# Per-component examples (uncomment to use):
# CAPTION_LM_EXTRA_TOKENS=1500
# CAPTION_LM_REASONING_EFFORT=minimal
# BUBBLE_LM_REASONING_EFFORT=low


# ----------------------------------------------------------------------------
# 3. PIPELINE TUNABLES (DISCRETE_<NAME>). Blank = default shown.
# The full list with defaults is class T in discrete/config.py. Every change
# shows up under "Config differences" in `discrete bench --compare`.
# ----------------------------------------------------------------------------
# Capture
DISCRETE_MOUSE_DEBOUNCE_S=
#   2.0   wait after the last click/scroll before capturing
DISCRETE_KEY_IDLE_DEBOUNCE_S=
#   6.0   wait after the last keystroke before capturing
DISCRETE_HEARTBEAT_MAX_GAP_S=
#   600   capture at least this often while the screen is in use
DISCRETE_FRAME_PHASH_MAX_DIST=
#   6     how different a frame must look to count as new (higher = fewer captures)
DISCRETE_SELF_APPS=
#   comma list of apps treated as DIscrete's own output: stored for audit, no model calls
DISCRETE_DENIED_APPS=
#   comma list of apps NEVER watched: nothing stored, no screenshot, Bubble off there.
#   App name as in the menu bar or its bundle id, e.g. WhatsApp,com.apple.Terminal
#   (password managers are always denied: 1Password, Bitwarden, Keychain Access, …)
DISCRETE_DENIED_SITES=
#   comma list of websites NEVER watched; a domain covers its subdomains,
#   e.g. hdfcbank.com,mail.google.com (only Gmail, not all of google.com)
DISCRETE_REDACT_SECRETS=
#   true  remove API keys, tokens, passwords, JWTs and private keys from screen text,
#         titles, URLs, captions and Bubble's field before storing or any model call;
#         a capture that showed a secret keeps no screenshot

# Captions (the biggest cost)
DISCRETE_VLM_MAX_WIDTH=
#   1024  screenshot width sent to the caption model (smaller = cheaper)
DISCRETE_VLM_IMAGE_DETAIL=
#   low   low | high | auto
DISCRETE_ENRICH_CONCURRENCY=
#   2     caption calls in flight at once
DISCRETE_ENRICH_MAX_PENDING=
#   8     captures holding a caption task in memory; the rest wait on disk
DISCRETE_CAPTURE_MAX_RETRIES=
#   3     attempts per caption before keeping the basic "App: Window" label
DISCRETE_LLM_TIMEOUT_S=
#   60    default request timeout for every model

# Episodes and background processing
DISCRETE_EPISODE_IDLE_CLOSE_S=
#   300   an episode closes (and is drafted) after this much inactivity
DISCRETE_EPISODE_MAX_S=
#   1800  longest episode
DISCRETE_CONSOLIDATION_INTERVAL_MIN=
#   60    minutes between merges (entity pages, day digests); checked once a minute.
#         Lower = fresher pages and digests, more model calls. Replaces _INTERVAL_S when set.
DISCRETE_FAILED_WORK_RETRY_S=
#   900   failed drafts/embeddings retry after this, then with doubling waits
DISCRETE_LLM_PROVIDER_RETRIES=
#   3     retries of a router's transient upstream errors (OpenRouter 404 model_not_found,
#         502/503) before a call counts as failed

# Dreaming: patterns across sessions, conflicts, staleness, your profile (discrete dream)
DISCRETE_DREAM_INTERVAL_MIN=
#   1440  minutes between dreams (default once a day); a dream also needs
#         DREAM_MIN_NEW_EPISODES new episodes since the last one. 0 = only by hand.
DISCRETE_DREAM_MIN_NEW_EPISODES=
#   5
DISCRETE_DREAM_MIN_EPISODES=
#   3     a pattern must rest on memories from this many separate episodes
DISCRETE_DREAM_MIN_DAYS=
#   2     ...and habits/preferences on this many separate days
DISCRETE_STALE_DAYS=
#   45    facts, preferences and patterns not seen again for this long are marked stale
DISCRETE_PATTERN_RETIRE_DAYS=
#   120   a pattern with no backing memory for this long is retired
# DREAM_LM_MODEL_NAME= / _API_KEY= / _API_BASE= / _REASONING_EFFORT=
#         the dreaming model (default: CONSOLIDATE_LM, then INSIGHT_LM). It runs rarely
#         and reads a lot, so a stronger model pays off here.

# Causal trails: what led to each download, install, purchase, message... ("why did I ...")
DISCRETE_TRAILS=
#   true
DISCRETE_TRAIL_WINDOW_MIN=
#   30    how far back before an action to look for what led to it

# Entities and graph
DISCRETE_ENTITY_INTERVAL_MIN=
#   10    minutes between entity promotion + graph rebuild (also at every merge)
DISCRETE_GRAPH_EXPAND=
#   false true = search also follows each named entity's strongest neighbours

# Search and Bubble
DISCRETE_PLAN_TIMEOUT_S=
#   4     Bubble waits this long for query planning, then searches without it
DISCRETE_QUERY_LLM_PLAN=
#   true  false = skip the planning call entirely (faster, less clever)
DISCRETE_SUPPORT_CHECK=
#   true  false = skip the VERIFY_LM check that drops related-but-unsupporting
#         records (faster, but e.g. a calculator result can be read as a salary)
DISCRETE_SUPPORT_TIMEOUT_S=
#   8     a slower verifier leaves results unverified (counted in `discrete bench`)
DISCRETE_TOP_K=
#   8     records handed to Bubble's writer
DISCRETE_BUBBLE_HOTKEY=
#   <alt>+<tab>
DISCRETE_BUBBLE_WRITER_MAX_TOKENS=
#   600   longest Bubble answer

# Retention
DISCRETE_FRAME_TTL_DAYS=
#   3     screenshots are deleted after this many days
DISCRETE_SCREEN_TEXT_TTL_DAYS=
#   90    on-screen text is cleared after this many days
