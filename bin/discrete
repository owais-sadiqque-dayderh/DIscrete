#!/bin/bash
# discrete — one command for DIscrete (this checkout; link it under another name to test a branch).
#
#   discrete start                   start watching + Bubble (Option+Tab) in the background
#   discrete stop                    stop it
#   discrete restart                 stop, then start (after editing .env)
#   discrete status                  running or not, what's stored, blocked apps/sites, credit left
#
#   discrete memories [N]            the last N memories DIscrete wrote about you (default 20)
#   discrete episodes [N]            the last N episodes: what you were doing, summarised (default 10)
#   discrete captured [N]            the last N raw captures: app, window, caption (default 20)
#   discrete ask "question"          ask from the terminal, with the records behind the answer
#   discrete search "question"       what search finds for a question (debugging a wrong answer)
#   discrete process                 turn waiting episodes into memories now
#   discrete consolidate             run the hourly merge (entity pages, day digests) now
#   discrete cost                    model calls, tokens and cost per component
#
#   discrete profile                 what it has learned about you, with the memories behind each point
#   discrete patterns                patterns learned across sessions, with how firmly each is held
#   discrete dream                   learn patterns, resolve conflicts, refresh the profile now
#   discrete changes [SINCE]         the memory change log (e.g. discrete changes 2h)
#   discrete history ID              every version of memory ID and why it changed
#   discrete forget ID               forget memory ID and never re-learn it (undo: discrete revert)
#   discrete correct ID "text"       replace memory ID's wording with yours
#   discrete revert EVENT            undo one change from the change log
#   discrete graph [NAME]            people/projects/tools and how they connect
#   discrete export                  write your memory as Markdown (a git folder; opens in Obsidian)
#
#   discrete block app NAME          never watch an app      (e.g. discrete block app WhatsApp)
#   discrete block site DOMAIN       never watch a website   (e.g. discrete block site hdfcbank.com)
#   discrete unblock app|site X      stop blocking it
#   discrete blocked                 list what is blocked
#
#   discrete setup                   check permissions and models (no screen content shown or sent)
#   discrete logs                    follow the log
#
#   discrete COMMAND …               any other command (run, why, query, eval, bench, attention, pages,
#                                    encrypt, …) goes to the Python CLI; `discrete COMMAND -h` shows its options

set -euo pipefail

# The script lives in bin/; the checkout is its parent.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
DIS="$ROOT"
BIN="$DIS/.venv/bin/discrete"
ENV_FILE="$DIS/.env"
# Use the same dotenv/environment resolver as the app, including DISCRETE_DB.
umask 077
STATE="$(cd "$DIS" && "$DIS/.venv/bin/python" -c 'from discrete.config import data_dir; print(data_dir().resolve())')"
LOG="$STATE/discrete.log"
mkdir -p "$STATE"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
die() { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

envval() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true; }
dis() { (cd "$DIS" && "$BIN" "$@"); }
db() { dis runtime-paths | "$DIS/.venv/bin/python" -c 'import json,sys; print(json.load(sys.stdin)["db"])'; }
q() { dis read-sql "$1"; }
running() { dis instance status >/dev/null; }
# This checkout's daemons, matched by the full path of its own binary.
daemons() { ps -axo pid=,command= | awk '$3 ~ /\/bin\/discrete$/ && $4 == "run" && NF == 4 {print $1, $3}'; }
legacy_pids() { daemons | awk -v bin="$BIN" '$2 == bin {print $1}'; }

credit() {
  local key; key="$(envval CORE_LM_API_KEY)"
  [ -n "$key" ] || { warn "no CORE_LM_API_KEY in $ENV_FILE"; return; }
  curl -s https://openrouter.ai/api/v1/credits -H "Authorization: Bearer $key" |
    python3 -c 'import json,sys; d=json.load(sys.stdin)["data"]; print(f"  OpenRouter credit left: ${d["total_credits"]-d["total_usage"]:.2f}")' 2>/dev/null ||
    warn "could not read OpenRouter credit"
}

start() {
  [ -x "$BIN" ] || die "DIscrete is not installed: cd $DIS && uv venv .venv && VIRTUAL_ENV=.venv uv pip install -e '.[dev]'"
  if running; then ok "DIscrete is already running"; return; fi
  [ -z "$(legacy_pids)" ] || die "an older DIscrete from this checkout is still running without the data-dir lock; run: discrete stop"
  local others; others="$(daemons | awk -v bin="$BIN" '$2 != bin {print $1}')"
  [ -z "$others" ] || warn "another DIscrete checkout is running (pid $(echo $others)); both use Option+Tab — stop it from its own checkout"
  (cd "$DIS" && exec nohup "$BIN" run >>"$LOG" 2>&1 </dev/null) >/dev/null 2>&1 &
  sleep 5
  running || die "DIscrete stopped right away; see: discrete logs   (or: discrete setup)"
  ok "DIscrete is watching; Bubble is on Option+Tab"
}

stop() {
  dis instance stop || die "shutdown incomplete; restart aborted"
  # A daemon started by an older launcher holds no lease; stop it by this checkout's exact binary path.
  local pids; pids="$(legacy_pids)"
  if [ -n "$pids" ]; then
    kill $pids 2>/dev/null || true
    for _ in $(seq 20); do [ -z "$(legacy_pids)" ] && break; sleep 0.5; done
    [ -z "$(legacy_pids)" ] || die "shutdown incomplete (pid $(echo $(legacy_pids))); restart aborted"
  fi
  ok "DIscrete stopped"
}

# Edit DISCRETE_DENIED_APPS / DISCRETE_DENIED_SITES in .env (add or remove one entry).
edit_list() {
  python3 - "$ENV_FILE" "$1" "$2" "$3" <<'PY'
import sys
path, var, action, value = sys.argv[1:]
lines = open(path).read().splitlines()
idx = next((i for i, l in enumerate(lines) if l.startswith(var + "=")), None)
items = [x.strip() for x in lines[idx].split("=", 1)[1].split(",") if x.strip()] if idx is not None else []
low = [x.lower() for x in items]
if action == "add":
    if value.lower() in low:
        print(f"  already blocked: {value}"); sys.exit(0)
    items.append(value)
else:
    if value.lower() not in low:
        print(f"  was not blocked: {value}"); sys.exit(0)
    items = [x for x in items if x.lower() != value.lower()]
line = f"{var}={','.join(items)}"
if idx is None:
    lines.append(line)
else:
    lines[idx] = line
open(path, "w").write("\n".join(lines) + "\n")
print(f"  {'blocked' if action == 'add' else 'unblocked'}: {value}")
PY
}

cmd="${1:-help}"; shift || true
# Shortcuts below add friendly defaults; with any option they hand over to the Python CLI unchanged.
for arg in "$@"; do
  case "$arg" in -*) case "$cmd" in ask | profile | dream | changes) exec_cli=1 ;; esac ;; esac
done
[ -z "${exec_cli:-}" ] || { cd "$DIS" && exec "$BIN" "$cmd" "$@"; }

case "$cmd" in
  start) bold "Starting DIscrete"; start; credit ;;
  stop) stop ;;
  restart) stop; start ;;
  status)
    bold "DIscrete"
    running && ok "running (Bubble on Option+Tab)" || warn "stopped (discrete start)"
    if [ -f "$(db)" ]; then
      q "select (select count(*) from observations), (select count(*) from episodes),
         (select count(*) from claims where status='live'),
         coalesce(datetime(max(started_at),'unixepoch','localtime'),'never') from observations;" |
        { IFS=$'\t' read -r o e c last
          echo "  stored: $o captures, $e episodes, $c memories (last capture: $last)"; }
    fi
    echo "  blocked apps:  $(envval DISCRETE_DENIED_APPS) (+ password managers)"
    echo "  blocked sites: $(envval DISCRETE_DENIED_SITES)"
    credit
    ;;
  memories)
    q "select datetime(occurred_from,'unixepoch','localtime'), kind, modality, text from claims
       where status='live' order by occurred_from desc limit ${1:-20};" |
      awk -F'\t' '{printf "  %s  %-10s %-8s %s\n", substr($1,6,11), $2, $3, substr($4,1,140)}'
    echo "  (event = something you did or viewed · fact/preference = lasting · engaged = you acted, passive = you only saw it)"
    ;;
  episodes)
    q "select datetime(started_at,'unixepoch','localtime'), strftime('%H:%M',ended_at,'unixepoch','localtime'), status, title, summary
       from episodes order by started_at desc limit ${1:-10};" |
      awk -F'\t' '{printf "\n  %s–%s  [%s]  %s\n    %s\n", substr($1,6,11), $2, $3, $4, substr($5,1,260)}'
    ;;
  captured)
    q "select datetime(started_at,'unixepoch','localtime'), app, window_title, caption from observations
       order by id desc limit ${1:-20};" |
      awk -F'\t' '{printf "  %s  %-14s %-30s %s\n", substr($1,6,11), substr($2,1,14), substr($3,1,30), substr($4,1,100)}'
    ;;
  ask) [ $# -gt 0 ] || die 'usage: discrete ask "question"'; dis ask "$*" --records ;;
  search) [ $# -gt 0 ] || die 'usage: discrete search "question"'; dis query "$*" ;;
  cost) dis stats ;;
  block | unblock)
    kind="${1:-}"; value="${2:-}"
    [ -n "$value" ] && { [ "$kind" = app ] || [ "$kind" = site ]; } || die "usage: discrete $cmd app NAME | discrete $cmd site DOMAIN"
    var=$([ "$kind" = app ] && echo DISCRETE_DENIED_APPS || echo DISCRETE_DENIED_SITES)
    edit_list "$var" "$([ "$cmd" = block ] && echo add || echo remove)" "$value"
    if running; then echo "  restarting DIscrete so it takes effect…"; stop; start; fi
    ;;
  blocked)
    echo "  apps:  $(envval DISCRETE_DENIED_APPS)"
    echo "         + always: 1Password, Bitwarden, Keychain Access, Passwords, LastPass, Dashlane, KeePassXC, Enpass"
    echo "  sites: $(envval DISCRETE_DENIED_SITES)"
    ;;
  profile) dis profile --ids ;;
  patterns)
    q "select id, context, round(confidence,2), text from claims where status='live' and kind='pattern' order by confidence desc;" |
      awk -F'\t' '{printf "  #%-5s %-12s %-5s %s\n", $1, $2, $3, $4}'
    ;;
  dream) dis dream --force ;;
  changes) dis changes --since "${1:-all}" ;;
  setup) dis doctor --models ;;  # one pass: permissions, then synthetic model checks
  logs) tail -f "$LOG" ;;
  help | -h | --help) sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//' ;;
  # Everything else (process, history, forget, run, why, eval, …) is the Python CLI itself.
  *) [ -x "$BIN" ] || die "DIscrete is not installed: cd $DIS && uv venv .venv && VIRTUAL_ENV=.venv uv pip install -e '.[dev]'"
     cd "$DIS" && exec "$BIN" "$cmd" "$@" ;;
esac
